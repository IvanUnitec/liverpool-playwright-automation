{
  "name": "liverpool-playwright-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Technical QA exercise - Liverpool e-commerce automation with Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "cross-env HEADLESS=false playwright test",
    "test:debug": "cross-env PWDEBUG=1 HEADLESS=false playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "cross-env": "^10.0.0",
    "typescript": "^5.9.0"
  }
}